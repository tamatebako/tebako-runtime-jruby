    linux-musl-x86_64: "00249449d9a1dfe83e3aaa40bca6c2819c5ae9ac49cca178557ef999bc9f8c6b"
    linux-musl-arm64: "3e2f59f1f184c0e839f5c386ef8a8c83b7eb9beb672215e4c7ac824870d4ae7f"
