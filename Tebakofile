        linux-musl-x86_64: "c7b8e164958c653b011bbd2541e9b7ab63891328ad41cf9af16ae074f41005c5"
        linux-musl-arm64: "089eb6fd82b804ff4f047afdbb96f9f338d45eb9ee0bca5ef3dd3cd9ad0147ff"
