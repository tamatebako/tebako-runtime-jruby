# Factory tools used by tools/build: the tfs CLI (the in-process imager)
# and tebako-shim (the composed smoke's dispatcher) from the
# tamatebako/tebako release. The digests are the pinned line's own
# monolith SHA256SUMS entries (v2.8.50, fetched 2026-10-21); the fetch
# steps cross-check against the monolith. v2.5.0 is the model floor: tfs mkimage
# re-serializes the embedded manifest THROUGH the tpkg model, and only
# the 2.5.0+ model round-trips on_runtime + the widened requires grammar
# (the 2.4.0 CLI would silently strip the owner edge). (link-unit rides
# the pin shape for the day a leg needs the preload grant; the jvm
# layout declares none — spec 33 §5.)
#
# The shim map covers seven platforms, NOT eight: tebako's
# windows-ucrt-arm64 surface is runtime-own (tfs + tebako-pkg + the
# launcher ship; NO tebako-shim — the v2.8.50 monolith carries none).
# An emulated x64 shim cannot substitute: the store scan's platform
# filter is the dispatcher's COMPILED-IN arch (tpkg::runtime_store's
# scan_cached → platform_string), so a ucrt64 shim never sees
# windows-ucrt-arm64 store entries and the dispatch fails by name ("no
# cached ruby runtimes for this platform"). The shim-driven cells (the
# composed + cext smokes) are therefore WAIVED on that leg — pins.rb
# emits COMPOSED_SMOKE=0 for a platform the no_native_shim list declares,
# and the composed windows wire's proof lives on the x86_64 leg (a
# platform the product DOES ship a dispatcher for). The win-arm64 leg's
# standalone fail-closed gate, artifact pairing, and every pin
# cross-check (the owner release's sidecars included) run unchanged.
tools:
  repo: "tamatebako/tebako"
  release: "v2.8.57"
  # Asset platforms the pinned line ships NO native tebako-shim for (the
  # runtime-own surface). Recipe data, never a code-side guess (spec 00
  # §9): pins.rb skips the shim pin for a listed platform — a NATIVE shim
  # pin for a listed platform is a contradiction it refuses loudly — and
  # emits COMPOSED_SMOKE=0, so tools/build waives the shim-driven cells.
  no_native_shim:
    - windows-ucrt-arm64
  sha256:
